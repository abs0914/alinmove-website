# ─────────────────────────────────────────────────────────────────────────
# ALiN Move Web — environment variables
# Copy to .env.local and fill in. Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Public (NEXT_PUBLIC_*) — readable on the client ──────────────────────

# The launch-mode flag. See lib/launch-mode.ts and the launch-mode-flag skill.
# Day 0–60: waitlist | Day 61+: live
NEXT_PUBLIC_LAUNCH_MODE=waitlist

# Optional ISO timestamp; if set, hero may show "Apps go live in N days"
NEXT_PUBLIC_LAUNCH_TARGET_DATE=

# Used for absolute URLs (sitemap, OG, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Post-launch only — set when apps drop
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.alinmove.customer&pcampaignid=web_share
NEXT_PUBLIC_PLAY_STORE_URL_RIDER=https://play.google.com/store/apps/details?id=com.alinmove.driver&pcampaignid=web_share
NEXT_PUBLIC_DEEPLINK_SCHEME=alinmove

# ── Payload v3 ───────────────────────────────────────────────────────────

# Postgres connection string for Payload (recommended: a Supabase project
# DISTINCT from the Rider App's Supabase, to avoid migration collisions).
DATABASE_URI=postgres://user:password@host:5432/alinmove_payload

# A long random string. Used to sign Payload JWTs and cookies.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── Customer waitlist (Supabase + Resend) ────────────────────────────────

# Supabase project for the waitlist table (separate from Payload + Rider App).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Driver-apply Supabase (Rider App project — server-side only).
RIDER_APP_SUPABASE_URL=
RIDER_APP_SUPABASE_SERVICE_ROLE_KEY=

# Resend — confirmation email at signup, batch announce at launch.
RESEND_API_KEY=
RESEND_FROM_EMAIL="ALiN Move <hello@mail.alinmove.com>"

# ── Pricing calculators ──────────────────────────────────────────────────

# PSGC provides administrative names/codes; geocoding
# and routing turn selected barangays into distance estimates. Override these
# URLs when using managed production providers.
PSGC_API_BASE_URL=https://psgc.gitlab.io/api
GEOCODING_API_URL=https://nominatim.openstreetmap.org
ROUTING_API_URL=https://router.project-osrm.org
GEOCODING_USER_AGENT="ALiN Move pricing calculator (https://alinmove.com)"

# ── Public package tracking (server-side ALiN Cargo adapter) ─────────────

# Example path shape only; confirm the real Cargo route before deployment.
# The placeholder is required and is URL-encoded by the server.
ALIN_CARGO_API_BASE_URL=
ALIN_CARGO_TRACKING_PATH=/tracking/{trackingNumber}

# Keep this server-side. Header/scheme are configurable because the upstream
# authentication contract is not present in this repository.
ALIN_CARGO_API_KEY=
ALIN_CARGO_AUTH_HEADER=Authorization
ALIN_CARGO_AUTH_SCHEME=Bearer
ALIN_CARGO_API_TIMEOUT_MS=6000

PUBLIC_TRACKING_RATE_LIMIT_MAX=20
PUBLIC_TRACKING_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_TRACKING_LOCATION_FRESHNESS_SECONDS=120
PUBLIC_TRACKING_LOCATION_RECENT_SECONDS=900

# POD media remains hidden by default. Enable only after privacy approval and
# only when Cargo supplies an HTTPS URL with a future expiry timestamp.
ALIN_CARGO_PUBLIC_POD_ENABLED=false
ALIN_CARGO_PUBLIC_RECIPIENT_ENABLED=false

# Optional restricted browser key. Without it, verified rider location is
# represented textually and no map request is made.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ── Revalidation webhook (Payload → Next ISR) ────────────────────────────

REVALIDATE_SECRET=change-me

# ── Careers / ATS ─────────────────────────────────────────────────────────

# Supabase Storage bucket where resumes are uploaded (private bucket; signed
# URLs only). Reuses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=resumes

# Signed-URL TTL in seconds. 604800 = 7 days.
RESUME_SIGNED_URL_TTL=604800

# Fallback email for new-application notifications when a JobListing has no
# applyEmailNotify set. Leave blank to disable global notifications.
APPLICATIONS_NOTIFY_FALLBACK_EMAIL=careers@alinmove.com

# ── Analytics (pick one provider — GA4 or PostHog) ───────────────────────

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
